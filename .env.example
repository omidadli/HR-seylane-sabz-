# Environment Variables for Seilaneh Sabz Enterprise HRMS
# Render / Database (Render PostgreSQL connects via DATABASE_URL automatically)
DATABASE_URL=
PORT=10000


# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Gemini Model (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
